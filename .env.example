# ==============================================================================
# OpenRed API - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.dev or .env.prod and fill in the values
# DO NOT commit .env files with real credentials to git!

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
DEBUG=False
SECRET_KEY=your-secret-key-here-generate-with-python-secrets
ALLOWED_HOSTS=api.open-red.es,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Frontend & Domain Configuration
# ------------------------------------------------------------------------------
# Development: http://localhost:3000
# Production: https://map.open-red.es
FRONTEND_URL=https://map.open-red.es

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL + PostGIS)
# ------------------------------------------------------------------------------
DB_NAME=openred_db
DB_USER=openred_user
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5434

# ------------------------------------------------------------------------------
# Email Configuration
# ------------------------------------------------------------------------------
# Options: 
#   - django.core.mail.backends.console.EmailBackend (development)
#   - django_ses.SESBackend (production with AWS SES)
EMAIL_BACKEND=django_ses.SESBackend
DEFAULT_FROM_EMAIL=noreply@ibercivis.es
SERVER_EMAIL=noreply@ibercivis.es

# ------------------------------------------------------------------------------
# PDF reports
# ------------------------------------------------------------------------------
# Default language for generated PDF reports when the request carries no
# ?lang= parameter nor a supported Accept-Language header. Values: en | es
REPORT_DEFAULT_LANGUAGE=en
# User-Agent for OpenStreetMap basemap tiles in report maps. OSM blocks anonymous
# agents (returns "Access blocked" tiles), so identify the app and a contact.
OSM_TILE_USER_AGENT=OpenRed-API/1.0 (+https://api.open-red.es; noreply@ibercivis.es)

# AWS SES Configuration (only if using django_ses.SESBackend)
AWS_SES_REGION_NAME=eu-central-1
AWS_SES_REGION_ENDPOINT=email.eu-central-1.amazonaws.com
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_SES_CONFIGURATION_SET=

# ------------------------------------------------------------------------------
# Redis Configuration (for RQ background tasks)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Shared Redis on this host: each Django project gets its own DB number to avoid
# rq-scheduler clobbering other projects' scheduled jobs. openred -> DB 4.
REDIS_DB=4

# ------------------------------------------------------------------------------
# External APIs
# ------------------------------------------------------------------------------
OSR_API_KEY=your-openstreetroute-api-key
# Aviso por correo al terminar de procesar cada track (coma-separado; vacío = desactivado)
TRACK_UPLOAD_NOTIFY_EMAILS=frasanz@ibercivis.es,dlisbona@ibercivis.es,germangil@ibercivis.es
TRACK_UPLOAD_NOTIFY_EXCLUDE_PROJECTS=radiation-test
# Límites de subida de tracks (RCTRK y JSON)
TRACK_UPLOAD_MAX_POINTS=20000
TRACK_UPLOAD_MAX_BYTES=10485760
# Rate limit por usuario para /api/tracks/upload/ y /api/tracks/upload_json/ (formato DRF: n/second|minute|hour|day)
TRACK_UPLOAD_RATE=30/hour
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# Security Settings (HTTPS/SSL - Production Only)
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ------------------------------------------------------------------------------
# Notes
# ------------------------------------------------------------------------------
# To generate a SECRET_KEY:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
#
# To load environment in bash:
# export $(cat .env.dev | xargs)
#
# To switch environments:
# cp .env.dev .env  # for development
# cp .env.prod .env  # for production
